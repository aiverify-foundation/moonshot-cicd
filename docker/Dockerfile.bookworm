FROM node:22-bookworm AS node_base
FROM python:3.12-slim-bookworm AS build

WORKDIR /app

# Create a non-root user and group.
RUN groupadd --system appgroup && \
    useradd --system --uid 1001 --gid appgroup appuser

# Upgrade system packages
RUN apt-get update && apt-get -y upgrade && \
    rm -rf /var/lib/apt/lists/*

COPY --from=node_base /usr/local/bin/node /usr/local/bin/node
COPY --from=node_base /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm && \
    ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx

# Moonshot core contents live at /app (build from repo root)
COPY moonshot_core/ /app/

# Install Poetry and dependencies
RUN mkdir -p /app/data/database && \
    pip install poetry==2.1.2 --no-cache-dir && \
    poetry config virtualenvs.create false && \
    poetry install

# Build portal static export, then place it under /app/data/web
COPY moonshot_portal_app/ /tmp/moonshot_portal_app/
WORKDIR /tmp/moonshot_portal_app
RUN npm install && npm run build \
    && mkdir -p /app/data/web \
    && cp -a out/. /app/data/web/ \
    && rm -rf /tmp/moonshot_portal_app

WORKDIR /app

# Override moonshot_config.yaml frontend_build_directory for this image layout
ENV MOONSHOT_FRONTEND_BUILD_DIRECTORY=/app/data/web

RUN chown -R appuser:appgroup /app

# Switch to the non-root user
USER appuser
EXPOSE 8000

