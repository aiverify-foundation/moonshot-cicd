index e6c88ab..b6d1b4e 100644
--- a/.ci/run-test.sh
+++ b/.ci/run-test.sh
@@ -1,4 +1,4 @@
-source_dirs="${@:-src process_check_app}"
+source_dirs="${@:-moonshot_be process_check_app}"
 
 export PYTHONPATH=$(pwd)
 echo "Testing source dirs: $source_dirs"
@@ -7,14 +7,21 @@ echo "##########################################################################
 echo "###                        UNIT TEST & CODE COVERAGE                      ###"
 echo "#############################################################################"
 
-test_cmd="pytest -v --durations=20"
-
 set +e
-$test_cmd --cov=${source_dirs// / --cov=} --cov-branch --html=test-report.html --json=combined-test-report.json
-exit_code=$?
+overall_exit_code=0
+
+for dir in $source_dirs; do
+  echo "Running tests in $dir"
+  (cd $dir && pytest -v --durations=20 --cov=. --cov-branch --html=../${dir}-test-report.html --json=../${dir}-test-report.json)
+  exit_code=$?
+  if [ $exit_code -ne 0 ]; then
+    overall_exit_code=$exit_code
+  fi
+done
+
+set -e
+coverage combine $(for dir in $source_dirs; do echo "$dir/.coverage"; done)
 coverage html
 coverage json --pretty-print -o combined-cov.json
-set -e
-if [ $exit_code -ne 0 ]; then
-  exit $exit_code
-fi
\ No newline at end of file
+
+exit $overall_exit_code
